<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>UaCodes</PackageId>
    <Version>0.1.0</Version>
    <Authors>Maksym Harkusha</Authors>
    <Description>Перевірка українських кодів: ЄДРПОУ, РНОКПП, IBAN, EIC, КАТОТТГ. Контрольні розряди, нормалізація, код банку з IBAN, тип об'єкта з EIC, область з КАТОТТГ. Без залежностей.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ukraine;edrpou;rnokpp;iban;eic;katottg;validation</PackageTags>
    <RepositoryUrl>https://github.com/maksym-garkusha/ua-codes</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Source Link уже є в SDK. Тут PDB їде окремим .snupkg, а згенеровані під час збірки
       файли вкладаються в нього, бо в репозиторії їх немає і відладчик не знайшов би їх за посиланням. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <!-- MIT вимагає, щоб текст ліцензії йшов разом із копіями коду, тож кладемо його в пакет поруч із виразом ліцензії -->
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
